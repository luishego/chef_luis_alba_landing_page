---
import { platos } from '../../content/site';
const n = platos.length;
---
<section class="scene plato-scene" id="plato" aria-labelledby="plato-title">
  <div class="stage">
    <div class="plato-grid wrap">
      <div class="plato-copy">
        <p class="eyebrow">El plato</p>
        <h2 class="display plato-title" id="plato-title">Lo que <em>aparece.</em></h2>
        <ol class="stops">
          {platos.map((p, i) => (
            <li class="stop" data-anim style={`--s:${i / n};--l:${1 / n}`}>
              <span class="stop-n">{`0${i + 1}`}</span>
              <span class="stop-name">{p.nombre}</span>
              <span class="stop-note">{p.nota}</span>
            </li>
          ))}
        </ol>
        <p class="plato-foot">Platos de Pinolo · Fotos temporales</p>
      </div>
      <div class="frame">
        {platos.map((p, i) => (
          <img class="shot" data-anim style={`--s:${i / n};--l:${1 / n}`} src={p.img} width={p.w} height={p.h} alt={p.alt} loading="lazy" />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .plato-scene { height: calc(100vh + 150vh); height: calc(100svh + 150svh); }
  @media (max-width: 820px) { .plato-scene { height: calc(100svh + 100svh); } }
  .plato-scene .stage { background: var(--night); }
  .plato-grid { height: 100%; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px; align-items: center; padding-top: 70px; }
  .plato-copy { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .plato-title { font-size: calc(clamp(2.4rem, 4.6vw, 4.2rem) * var(--display-scale)); }
  .stops { list-style: none; margin: 0; padding: 0; }
  .stop {
    display: grid; grid-template-columns: 44px minmax(0, 1fr); column-gap: 14px; padding: 16px 0;
    border-top: 1px solid var(--line); animation-name: stop-on;
  }
  .stop:last-child { border-bottom: 1px solid var(--line); }
  .stop-n { grid-row: span 2; color: var(--accent); font-size: .8rem; font-weight: 600; letter-spacing: .1em; padding-top: 6px; }
  .stop-name { font-family: var(--font-display); font-size: calc(1.8rem * var(--display-scale)); line-height: 1.1; }
  .stop-note { font-size: .9rem; color: var(--muted); }
  .plato-foot { margin: 0; font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  @keyframes stop-on {
    0% { opacity: .32; }
    15%, 85% { opacity: 1; }
    100% { opacity: .32; }
  }

  .frame { position: relative; height: min(72vh, 680px); min-width: 0; }
  .shot {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 2px;
    animation-name: shot-in-out; box-shadow: 0 30px 60px rgba(0, 0, 0, .45);
  }
  @keyframes shot-in-out {
    0% { opacity: 0; transform: scale(1.06); clip-path: inset(18% 0 18% 0); }
    18% { opacity: 1; transform: scale(1.02); clip-path: inset(0 0 0 0); }
    82% { opacity: 1; transform: scale(1); clip-path: inset(0 0 0 0); }
    100% { opacity: 0; transform: scale(.98); clip-path: inset(0 0 0 0); }
  }

  @media (max-width: 820px) {
    .plato-grid { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto; gap: 18px; align-content: center; padding-top: 80px; }
    .frame { order: -1; height: 46svh; }
    .plato-title { display: none; }
    .stop { padding: 10px 0; }
    .stop-name { font-size: calc(1.4rem * var(--display-scale)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .plato-grid { grid-template-columns: minmax(0, 1fr); padding-block: 96px 64px; }
    .frame { height: auto; display: grid; gap: 16px; }
    .shot { position: static; height: auto; aspect-ratio: 4 / 3; }
  }
</style>

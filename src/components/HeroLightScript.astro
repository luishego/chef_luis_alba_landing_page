<script is:inline>
(function () {
  /* Luz del home (provisional): render WebGL que oscurece la foto y la reilumina desde el sartén.
     Se conserva tal como se aprobó en el prototipo. */
  var current = 'fuego';
  /* ---------- Escena por paleta ----------
     Referencia: llama naranja-roja sobre escena oscura con reiluminación cálida (video cinematográfico). */
  var LOOKS = {
    fuego:  { sat: 0.92, expo: 0.66, gamma: 1.16, shadow: [0.17, 0.10, 0.06],
              core: [1.00, 0.86, 0.52], mid: [1.00, 0.50, 0.13], edge: [0.80, 0.18, 0.04], light: [1.00, 0.47, 0.17] }
  };

  /* ---------- WebGL ---------- */
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  var small = window.matchMedia('(max-width: 820px)');
  var photo = document.getElementById('photo');
  var img = document.getElementById('photo-img');
  var canvas = document.getElementById('fire');
  var sparks = document.getElementById('sparks');
  var sctx = sparks.getContext('2d');
  var hero = document.querySelector('.hero');
  var gl = null, prog = null, U = {}, ready = false;

  var VS = 'attribute vec2 p; varying vec2 vUv; void main(){ vUv = vec2((p.x + 1.0) * 0.5, (1.0 - p.y) * 0.5); gl_Position = vec4(p, 0.0, 1.0); }';
  var FS = [
    'precision mediump float;',
    'varying vec2 vUv;',
    'uniform sampler2D uPhoto; uniform vec2 uRes; uniform float uTime, uFlare, uLight, uSmall;',
    'uniform vec3 uCore, uMid, uEdge, uLightCol, uShadow; uniform float uSat, uExpo, uGamma;',
    'float hash(vec2 p){ p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }',
    'float noise(vec2 p){ vec2 i = floor(p), f = fract(p); vec2 u = f * f * (3.0 - 2.0 * f);',
    '  return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y); }',
    'float fbm(vec2 p){ float v = 0.0, a = 0.5; for (int i = 0; i < 5; i++){ v += a * noise(p); p = p * 2.03 + vec2(1.7, 9.2); a *= 0.5; } return v; }',
    'vec3 ramp(float f){ vec3 c = mix(uEdge, uMid, smoothstep(0.12, 0.5, f)); return mix(c, uCore, smoothstep(0.55, 0.92, f)); }',
    'float flame(vec2 uv, vec2 base, float hw, float h, float speed, float t){',
    '  float qy = (base.y - uv.y) / h; float qx = (uv.x - base.x) / hw;',
    '  if (qy < -0.2 || qy > 1.7 || abs(qx) > 2.2) return 0.0;',
    '  vec2 np = vec2(uv.x * 15.0, uv.y * 8.0 + t * speed);',
    '  float n = fbm(np + vec2(0.0, fbm(np * 0.55 + t * 0.3) * 1.6));',
    '  float w = max(1.0 - qy * 0.55, 0.18);',
    '  float f = (1.0 - abs(qx) / w) * 1.15 + (n - 0.5) * 1.5 - qy * 1.05 + 0.22;',
    '  f *= smoothstep(-0.2, 0.06, qy);',
    '  return clamp(f, 0.0, 1.0); }',
    'void main(){',
    '  vec2 uv = vUv; float aspect = uRes.x / uRes.y;',
    '  vec3 alb = texture2D(uPhoto, uv).rgb;',
    '  float lum = dot(alb, vec3(0.299, 0.587, 0.114));',
    '  float cyan = smoothstep(0.06, 0.22, min(alb.g, alb.b) - alb.r);',   /* apaga el plato turquesa */
    '  alb = mix(alb, vec3(lum), cyan * 0.82);',
    '  vec3 g = mix(vec3(lum), alb, uSat);',
    '  g = pow(g, vec3(uGamma)) * uExpo;',
    '  g += uShadow * (1.0 - smoothstep(0.0, 0.5, lum)) * 0.07;',
    /* reiluminación desde el sartén */
    '  vec2 L = vec2(0.855, 0.575); vec2 d = (uv - L) * vec2(aspect, 1.0); float r2 = dot(d, d);',
    '  float near = exp(-r2 / 0.018); float far = exp(-r2 / 0.34);',
    '  float amt = uLight * (near * 1.5 + far * 0.95);',
    '  vec3 col = g + alb * uLightCol * amt * 1.05;',
    '  col += uLightCol * uLight * far * 0.07 * (0.4 + lum);',   /* humo iluminado */
    '  vec2 vc = (uv - vec2(0.6, 0.5)) * vec2(aspect, 1.0);',
    '  col *= 1.0 - smoothstep(0.32, 0.95, length(vc)) * 0.55;',
    /* llamarada sobre el contenido del sartén */
    '  float h = 0.035 + 0.40 * pow(uFlare, 0.8);',
    '  float f = flame(uv, vec2(0.855, 0.594), 0.08 * (1.0 + uFlare * 0.4), h, 3.0, uTime);',
    '  f *= smoothstep(0.02, 0.18, uFlare);',
    '  col += ramp(f) * smoothstep(0.04, 0.34, f) * 1.2;',
    /* lenguas de la hornilla bajo el sartén */
    '  float fb = flame(uv, vec2(0.80, 0.652), 0.085, 0.018 + 0.012 * uLight, 4.2, uTime * 1.3 + 7.0);',
    '  col += ramp(fb * 0.85) * smoothstep(0.05, 0.4, fb) * 0.9;',
    '  gl_FragColor = vec4(min(col, vec3(1.0)), 1.0);',
    '}'
  ].join('\n');

  function initGL() {
    try {
      gl = canvas.getContext('webgl', { alpha: false, antialias: false, preserveDrawingBuffer: false }) ||
           canvas.getContext('experimental-webgl');
    } catch (e) { gl = null; }
    if (!gl) return false;
    function sh(type, src) { var s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { console.warn(gl.getShaderInfoLog(s)); return null; } return s; }
    var v = sh(gl.VERTEX_SHADER, VS), f = sh(gl.FRAGMENT_SHADER, FS);
    if (!v || !f) return false;
    prog = gl.createProgram(); gl.attachShader(prog, v); gl.attachShader(prog, f); gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return false;
    gl.useProgram(prog);
    var buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    var loc = gl.getAttribLocation(prog, 'p'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    ['uPhoto','uRes','uTime','uFlare','uLight','uSmall','uCore','uMid','uEdge','uLightCol','uShadow','uSat','uExpo','uGamma']
      .forEach(function (n) { U[n] = gl.getUniformLocation(prog, n); });
    var tex = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, img);
    gl.uniform1i(U.uPhoto, 0);
    return true;
  }

  var W = 1, H = 1, DPR = 1;
  function resize() {
    var r = photo.getBoundingClientRect();
    DPR = Math.min(window.devicePixelRatio || 1, small.matches ? 1.5 : 1.75);
    W = Math.max(1, Math.round(r.width)); H = Math.max(1, Math.round(r.height));
    canvas.width = Math.round(W * DPR); canvas.height = Math.round(H * DPR);
    sparks.width = Math.round(W * DPR); sparks.height = Math.round(H * DPR);
    sctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    if (gl) gl.viewport(0, 0, canvas.width, canvas.height);
    if (!running) renderOnce();
  }

  /* ---------- Curva de la llamarada (medida en las referencias) ----------
     subida ~0.35 s, pico breve, caída ~1.2 s con rebotes, cola de lenguas pequeñas */
  var t = 0, last = 0, running = false, visible = true, enabled = true;
  var flareT = -1, nextFlare = 2.2, flare = 0, light = 0.1;
  function rand(a, b) { return a + Math.random() * (b - a); }
  function envelope(x) {
    if (x < 0.35) { var u = x / 0.35; return u * u * (3 - 2 * u); }
    var k = x - 0.35;
    var body = Math.exp(-k / 0.85);
    var bump = 0.16 * Math.sin(k * 10.5) * Math.exp(-k / 1.1) + 0.08 * Math.sin(k * 23.0) * body;
    return Math.max(0, Math.min(1.08, body + bump));
  }
  function idleFlicker(x) {
    return 0.09 + 0.025 * Math.sin(x * 7.3) + 0.018 * Math.sin(x * 13.1 + 1.7) + 0.012 * Math.sin(x * 23.7 + 0.4);
  }
  function triggerFlare() {
    if (!enabled || reduce.matches || !ready) return;
    flareT = 0; burst();
    if (!running) start();
  }

  /* ---------- Chispas ---------- */
  var embers = [];
  function burst() {
    var n = small.matches ? 14 : 26;
    for (var i = 0; i < n; i++) embers.push({
      x: rand(0.79, 0.92) * W, y: rand(0.56, 0.6) * H, vx: rand(-40, 40), vy: -rand(120, 320),
      life: 0, max: rand(0.9, 2.2), size: rand(0.9, 1.9), ph: rand(0, 6.28)
    });
  }
  function drawSparks(dt) {
    sctx.clearRect(0, 0, W, H);
    if (!embers.length) return;
    var lk = LOOKS[current];
    var c = 'rgb(' + Math.round(lk.core[0] * 255) + ',' + Math.round(lk.mid[1] * 255 + 30) + ',' + Math.round(lk.mid[2] * 255 + 40) + ')';
    sctx.fillStyle = c; sctx.shadowColor = c; sctx.shadowBlur = 6;
    for (var i = embers.length - 1; i >= 0; i--) {
      var e = embers[i]; e.life += dt; var a = e.life / e.max;
      if (a >= 1) { embers.splice(i, 1); continue; }
      e.vy *= (1 - 0.9 * dt); e.vx += Math.sin(t * 3 + e.ph) * 30 * dt;
      e.x += e.vx * dt; e.y += e.vy * dt;
      sctx.globalAlpha = (1 - a) * (0.55 + 0.45 * Math.sin(t * 20 + e.ph));
      sctx.beginPath(); sctx.arc(e.x, e.y, e.size, 0, 6.283); sctx.fill();
    }
    sctx.globalAlpha = 1; sctx.shadowBlur = 0;
  }

  var lastSpill = -1;
  function draw() {
    if (!gl || !ready) return;
    var lk = LOOKS[current];
    gl.uniform2f(U.uRes, canvas.width, canvas.height);
    gl.uniform1f(U.uTime, t);
    gl.uniform1f(U.uFlare, flare);
    gl.uniform1f(U.uLight, light);
    gl.uniform1f(U.uSmall, small.matches ? 1 : 0);
    gl.uniform3fv(U.uCore, lk.core); gl.uniform3fv(U.uMid, lk.mid); gl.uniform3fv(U.uEdge, lk.edge);
    gl.uniform3fv(U.uLightCol, lk.light); gl.uniform3fv(U.uShadow, lk.shadow);
    gl.uniform1f(U.uSat, lk.sat); gl.uniform1f(U.uExpo, lk.expo); gl.uniform1f(U.uGamma, lk.gamma);
    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    // la luz también se derrama sobre el fondo de la página y el titular
    var spill = Math.round(Math.min(1, flare) * 50) / 50;
    if (spill !== lastSpill) { hero.style.setProperty('--flare', spill); lastSpill = spill; }
  }
  function renderOnce() { if (!ready) return; flare = 0; light = 0.1; draw(); sctx.clearRect(0, 0, W, H); }

  function frame(now) {
    if (!running) return;
    var dt = Math.min(0.05, (now - last) / 1000 || 0.016); last = now; t += dt;
    if (flareT >= 0) {
      flareT += dt;
      flare = envelope(flareT);
      if (flareT > 3.6) { flareT = -1; flare = 0; nextFlare = rand(6, 10); }
    } else { nextFlare -= dt; if (nextFlare <= 0) triggerFlare(); }
    // la luz sigue a la llama con un leve parpadeo propio
    light = idleFlicker(t) + flare * (0.95 + 0.12 * Math.sin(t * 17.0) + 0.06 * Math.sin(t * 31.0));
    draw(); drawSparks(dt);
    requestAnimationFrame(frame);
  }
  function start() {
    if (running || !enabled || !ready || reduce.matches || !visible || document.hidden) return;
    running = true; last = performance.now(); requestAnimationFrame(frame);
  }
  function stop() { running = false; renderOnce(); }

  photo.addEventListener('click', triggerFlare);
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) { visible = entries[0].isIntersecting; if (visible) start(); else running = false; }).observe(photo);
  }
  document.addEventListener('visibilitychange', function () { if (document.hidden) running = false; else start(); });
  if (reduce.addEventListener) reduce.addEventListener('change', function () { if (reduce.matches) stop(); else start(); });
  if ('ResizeObserver' in window) new ResizeObserver(resize).observe(photo); else window.addEventListener('resize', resize);
  var go = function () {
    ready = initGL();
    photo.classList.add(ready ? 'gl' : 'nogl');
    resize(); renderOnce(); start();
  };
  if (img.decode) img.decode().then(go, go); else if (img.complete) go(); else img.addEventListener('load', go);
})();
</script>

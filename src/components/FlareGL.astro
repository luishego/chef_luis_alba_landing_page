---
// Versión anterior (WebGL), se conserva para comparar o volver a ella.
// Versión final: clip real de fuego sobre negro con mix-blend-mode: screen.
// Mientras llega el clip, una llama procedimental en WebGL ocupa su lugar.
// Las marcas <div class="flare-mark" data-flare="0..1"> indican dónde ocurre cada llamarada y con qué fuerza.
---
<div class="flare-glow" aria-hidden="true"></div>
<canvas class="flare-canvas" aria-hidden="true"></canvas>

<script is:inline>
  (function () {
    var reduce = matchMedia('(prefers-reduced-motion: reduce)');
    var glow = document.querySelector('.flare-glow');
    var canvas = document.querySelector('.flare-canvas');
    var marks = [].slice.call(document.querySelectorAll('.flare-mark'));
    if (!marks.length) return;
    var root = document.documentElement;
    var COLORS = {
      fuego:  { core: [1.0, 0.85, 0.50], mid: [1.0, 0.48, 0.12], edge: [0.75, 0.15, 0.03], spill: [1.0, 0.45, 0.16] }
    };

    var gl = null, U = {};
    try { gl = canvas.getContext('webgl', { alpha: true, premultipliedAlpha: true, antialias: false }); } catch (e) {}
    if (gl) {
      var VS = 'attribute vec2 p; varying vec2 vUv; void main(){ vUv = vec2((p.x+1.0)*0.5, (1.0-p.y)*0.5); gl_Position = vec4(p,0.0,1.0); }';
      var FS = [
        'precision mediump float; varying vec2 vUv;',
        'uniform vec2 uRes; uniform float uTime, uI; uniform vec3 uCore, uMid, uEdge, uSpill;',
        'float hash(vec2 p){ p = fract(p*vec2(123.34,456.21)); p += dot(p,p+45.32); return fract(p.x*p.y); }',
        'float noise(vec2 p){ vec2 i=floor(p), f=fract(p); vec2 u=f*f*(3.0-2.0*f); return mix(mix(hash(i),hash(i+vec2(1,0)),u.x), mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),u.x), u.y); }',
        'float fbm(vec2 p){ float v=0.0, a=0.5; for(int i=0;i<5;i++){ v+=a*noise(p); p=p*2.03+vec2(1.7,9.2); a*=0.5; } return v; }',
        'void main(){',
        '  float aspect = uRes.x/uRes.y; float b = 1.0 - vUv.y;',
        '  vec2 np = vec2(vUv.x*aspect*4.2, b*3.2 - uTime*1.7);',
        '  float n = fbm(np + vec2(fbm(np*0.6 + uTime*0.15)*0.8, fbm(np*0.5 - uTime*0.2)*1.8));',
        '  float H = uI * 1.15;',
        '  float f = (H - b) / max(H, 0.001) * 0.85 + (n - 0.5) * 2.1 - 0.02;',
        '  f = clamp(f, 0.0, 1.0) * smoothstep(0.0, 0.12, uI);',
        '  vec3 c = mix(uEdge, uMid, smoothstep(0.12, 0.55, f)); c = mix(c, uCore, smoothstep(0.78, 1.0, f));',
        '  float a = smoothstep(0.04, 0.34, f);',
        '  float haze = uI * 0.16 * (1.0 - b * 0.8);',
        '  vec3 col = c * a + uSpill * haze * (1.0 - a);',
        '  float alpha = clamp(a + haze, 0.0, 1.0);',
        '  gl_FragColor = vec4(col, alpha);',
        '}'
      ].join('\n');
      function sh(t, s) { var o = gl.createShader(t); gl.shaderSource(o, s); gl.compileShader(o); return gl.getShaderParameter(o, gl.COMPILE_STATUS) ? o : null; }
      var v = sh(gl.VERTEX_SHADER, VS), f = sh(gl.FRAGMENT_SHADER, FS);
      if (v && f) {
        var pr = gl.createProgram(); gl.attachShader(pr, v); gl.attachShader(pr, f); gl.linkProgram(pr);
        if (gl.getProgramParameter(pr, gl.LINK_STATUS)) {
          gl.useProgram(pr);
          var buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
          gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1,1,-1,-1,1,1,1]), gl.STATIC_DRAW);
          var loc = gl.getAttribLocation(pr, 'p'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
          ['uRes','uTime','uI','uCore','uMid','uEdge','uSpill'].forEach(function (k) { U[k] = gl.getUniformLocation(pr, k); });
        } else gl = null;
      } else gl = null;
    }

    function size() {
      if (!gl) return;
      var s = 0.5; // la llama es suave: media resolución basta
      canvas.width = Math.max(1, Math.round(innerWidth * s));
      canvas.height = Math.max(1, Math.round(innerHeight * s));
      gl.viewport(0, 0, canvas.width, canvas.height);
    }
    size(); addEventListener('resize', size);

    function intensity() {
      var vh = innerHeight, best = 0;
      for (var i = 0; i < marks.length; i++) {
        var top = marks[i].getBoundingClientRect().top / vh;
        var s = Math.max(0, 1 - Math.abs(top - 0.5) / 0.42);
        s = s * s * (3 - 2 * s) * (parseFloat(marks[i].dataset.flare) || 1);
        if (s > best) best = s;
      }
      return best;
    }

    var t = 0, last = 0, running = false, cur = 0;
    function draw(I) {
      glow.style.opacity = (I * 0.55).toFixed(3);
      if (!gl) return;
      canvas.style.opacity = I > 0.01 ? '1' : '0';
      var c = COLORS.fuego;
      gl.uniform2f(U.uRes, canvas.width, canvas.height);
      gl.uniform1f(U.uTime, t); gl.uniform1f(U.uI, I);
      gl.uniform3fv(U.uCore, c.core); gl.uniform3fv(U.uMid, c.mid); gl.uniform3fv(U.uEdge, c.edge); gl.uniform3fv(U.uSpill, c.spill);
      gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    }
    function frame(now) {
      var dt = Math.min(0.05, (now - last) / 1000 || 0.016); last = now; t += dt;
      var target = intensity();
      cur += (target - cur) * (1 - Math.exp(-dt * 10));
      draw(cur);
      if (cur > 0.004 || target > 0.004) requestAnimationFrame(frame);
      else { running = false; draw(0); }
    }
    function kick() {
      if (reduce.matches || running) return;
      running = true; last = performance.now(); requestAnimationFrame(frame);
    }
    addEventListener('scroll', kick, { passive: true });
    kick();
  })();
</script>

<style is:global>
  .flare-mark { position: relative; height: 0; pointer-events: none; }
  .flare-canvas {
    position: fixed; inset: 0; width: 100%; height: 100%; z-index: 25; pointer-events: none;
    opacity: 0; transition: opacity .2s linear;
  }
  .flare-glow {
    position: fixed; inset: 0; z-index: 24; pointer-events: none; opacity: 0;
    background: radial-gradient(120% 70% at 50% 110%, var(--spill), transparent 70%);
    mix-blend-mode: screen;
  }
  @media (prefers-reduced-motion: reduce) { .flare-canvas, .flare-glow { display: none; } }
</style>

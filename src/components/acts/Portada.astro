---
// Portada: flambeado real del chef en loop de fondo (cámara lenta 0.6x, ida y vuelta para que no se note el corte).
// La versión anterior (foto con luz simulada en WebGL) queda en HeroLightScript.astro como respaldo.
---
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <video class="hero-video" id="hero-video" autoplay muted loop playsinline preload="auto" poster="media/hero-flambeado-poster.webp" disablepictureinpicture>
      <source src="media/hero-flambeado.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero-inner wrap">
    <div class="copy">
      <p class="eyebrow">Chef · Cocina de autor</p>
      <h1 class="display hero-title" id="hero-title">Cocina de autor, <em>a fuego vivo.</em></h1>
      <p class="lede">Experiencias y eventos, restaurante, consultoría y clases. Una sola cocina, cuatro formas de sentarse a la mesa.</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#contacto">Cotiza tu evento</a>
        <a class="btn btn-ghost" href="#plato">Ver sus platos</a>
      </div>
      <p class="meta"><b>Ciudad de México</b><span>Pinolo</span></p>
    </div>
  </div>
  <a class="scroll-cue" href="#ingredientes">Desliza<span aria-hidden="true">↓</span></a>
</section>

<script is:inline>
  (function () {
    var v = document.getElementById('hero-video');
    if (!v) return;
    var reduce = matchMedia('(prefers-reduced-motion: reduce)');
    var visible = true;
    function sync() {
      if (reduce.matches || !visible || document.hidden) { v.pause(); return; }
      var p = v.play(); if (p && p.catch) p.catch(function () {});
    }
    if (reduce.matches) { v.removeAttribute('autoplay'); v.pause(); }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (e) { visible = e[0].isIntersecting; sync(); }).observe(v);
    }
    document.addEventListener('visibilitychange', sync);
    if (reduce.addEventListener) reduce.addEventListener('change', sync);
  })();
</script>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: 100vh; min-height: 100svh;
    display: flex; align-items: center;
    background: var(--night);
  }
  .hero-media { position: absolute; inset: 0; z-index: -1; }
  .hero-video {
    width: 100%; height: 100%; object-fit: cover; object-position: 70% 45%;
    filter: contrast(1.04) saturate(.95);
  }
  /* Oscurece el lado del texto y funde con el fondo de la página */
  .hero-media::after {
    content: ""; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(26, 18, 13, .95) 0%, rgba(26, 18, 13, .86) 30%, rgba(26, 18, 13, .42) 58%, rgba(26, 18, 13, .12) 100%),
      linear-gradient(to top, var(--night) 0%, rgba(26, 18, 13, 0) 26%),
      linear-gradient(to bottom, rgba(26, 18, 13, .7) 0%, rgba(26, 18, 13, 0) 20%);
  }
  .hero-inner { position: relative; width: 100%; }
  .copy {
    max-width: 640px; padding-block: 150px 120px;
    display: flex; flex-direction: column; gap: 26px;
  }
  .hero-title { font-size: calc(clamp(2.8rem, 5.6vw, 5rem) * var(--display-scale)); }
  .hero-title em { display: block; text-shadow: 0 0 34px rgba(255, 120, 45, .28); }
  .lede { margin: 0; max-width: 36ch; font-size: 1.1rem; color: var(--muted); }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero .btn-ghost { background: rgba(26, 18, 13, .35); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
  .meta {
    display: flex; flex-wrap: wrap; gap: 8px 26px; margin: 4px 0 0; padding-top: 18px;
    border-top: 1px solid var(--line); font-size: .8rem; letter-spacing: .04em; color: var(--muted);
  }
  .meta b { color: var(--cream); font-weight: 600; }

  .scroll-cue {
    position: absolute; z-index: 1; left: max(24px, env(safe-area-inset-left, 0px)); bottom: 26px;
    display: inline-flex; gap: 10px; align-items: center;
    font-size: .7rem; font-weight: 600; letter-spacing: .28em; text-transform: uppercase; color: var(--muted); text-decoration: none;
  }
  @media (min-width: 1300px) { .scroll-cue { left: calc((100vw - 1240px) / 2 + 24px); } }

  @media (max-width: 820px) {
    /* En celular el video va arriba como banda y el texto debajo: el fuego no queda tapado */
    .hero { display: block; min-height: 0; }
    .hero-media { position: relative; inset: auto; height: 60vh; height: 60svh; }
    .hero-video { object-position: 78% 62%; }
    .hero-media::after {
      background:
        linear-gradient(to top, var(--night) 0%, rgba(26, 18, 13, .55) 30%, rgba(26, 18, 13, 0) 55%),
        linear-gradient(to bottom, rgba(26, 18, 13, .6) 0%, rgba(26, 18, 13, 0) 24%);
    }
    .copy { position: relative; margin-top: -84px; padding-block: 0 72px; gap: 20px; }
    .scroll-cue { display: none; }
  }
</style>

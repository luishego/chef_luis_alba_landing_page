---
import HeroLightScript from '../HeroLightScript.astro';
---
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero-inner wrap">
    <div class="copy">
      <p class="eyebrow">Chef · Cocina de autor</p>
      <h1 class="display hero-title" id="hero-title">Cocina de autor, <em>a fuego vivo.</em></h1>
      <p class="lede">Experiencias y eventos, restaurante, consultoría y clases. Una sola cocina, cuatro formas de sentarse a la mesa.</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#contacto">Cotiza tu evento</a>
        <a class="btn btn-ghost" href="#plato">Ver sus platos</a>
      </div>
      <p class="meta"><b>Ciudad de México</b><span>Pinolo</span></p>
    </div>
    <figure class="photo" id="photo">
      <img id="photo-img" src="media/home.webp" width="1200" height="1598" alt="El chef Luis Alba saltea en un sartén sobre la estufa de su cocina" fetchpriority="high" />
      <canvas id="fire" aria-hidden="true"></canvas>
      <canvas id="sparks" aria-hidden="true"></canvas>
      <div class="vignette"></div>
    </figure>
  </div>
  <a class="scroll-cue" href="#ingredientes">Desliza<span aria-hidden="true">↓</span></a>
</section>
<HeroLightScript />

<style>
  .hero {
    --flare: 0;
    position: relative; overflow: hidden;
    background: radial-gradient(60% 70% at 80% 60%, rgba(255, 140, 50, 0.07), transparent 70%), var(--night);
  }
  .hero::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(70% 80% at 78% 58%, var(--spill), transparent 72%);
    opacity: calc(var(--flare) * 0.9);
  }
  .hero-inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 600px); align-items: center;
  }
  .copy {
    position: relative; z-index: 3; min-width: 0; max-width: 640px;
    padding-block: 150px 90px; margin-right: -90px;
    display: flex; flex-direction: column; gap: 26px;
  }
  .hero-title { font-size: calc(clamp(2.8rem, 5.6vw, 5rem) * var(--display-scale)); }
  .hero-title em { display: block; text-shadow: 0 0 calc(var(--flare) * 34px) var(--spill); }
  .lede { margin: 0; max-width: 36ch; font-size: 1.1rem; color: var(--muted); }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px; }
  .meta {
    display: flex; flex-wrap: wrap; gap: 8px 26px; margin: 4px 0 0; padding-top: 18px;
    border-top: 1px solid var(--line); font-size: .8rem; letter-spacing: .04em; color: var(--muted);
  }
  .meta b { color: var(--cream); font-weight: 600; }

  .photo {
    margin: 0; position: relative; z-index: 1; width: 100%; max-width: 100%;
    aspect-ratio: 1200 / 1598; cursor: pointer;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 24%), linear-gradient(to top, transparent 0%, #000 14%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0%, #000 24%), linear-gradient(to top, transparent 0%, #000 14%);
    mask-composite: intersect;
  }
  .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .photo canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; display: none; }
  .photo #sparks { mix-blend-mode: screen; }
  .photo.gl canvas { display: block; }
  .photo.nogl img { filter: contrast(1.08) saturate(0.82) brightness(0.8); }
  .vignette {
    position: absolute; inset: 0; pointer-events: none; display: none;
    background: radial-gradient(85% 70% at 62% 52%, transparent 55%, rgba(8, 6, 5, 0.6) 100%);
  }
  .photo.nogl .vignette { display: block; }

  .scroll-cue {
    position: absolute; z-index: 4; left: max(24px, env(safe-area-inset-left, 0px)); bottom: 26px;
    display: inline-flex; gap: 10px; align-items: center;
    font-size: .7rem; font-weight: 600; letter-spacing: .28em; text-transform: uppercase; color: var(--muted); text-decoration: none;
  }
  @media (min-width: 1300px) { .scroll-cue { left: calc((100vw - 1240px) / 2 + 24px); } }

  @media (max-width: 820px) {
    .hero-inner { grid-template-columns: minmax(0, 1fr); }
    .photo {
      order: -1; margin-inline: calc(-1 * max(24px, env(safe-area-inset-left, 0px)));
      width: auto; max-width: none;
      -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 22%);
      mask-image: linear-gradient(to top, transparent 0%, #000 22%);
    }
    .copy { margin-right: 0; margin-top: -70px; padding-block: 0 80px; gap: 20px; }
    .scroll-cue { display: none; }
  }
</style>

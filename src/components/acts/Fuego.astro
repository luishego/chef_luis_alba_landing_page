---
import { pasos } from '../../content/site';
---
<section class="fuego" id="fuego" aria-labelledby="fuego-title">
  <div class="fuego-inner wrap">
    <div class="fuego-head">
      <p class="eyebrow">El fuego · Cómo trabajo</p>
      <h2 class="display fuego-title" id="fuego-title">De la primera charla <em>a la mesa.</em></h2>
      <figure class="fuego-photo">
        <img src="media/cuchillo-hierbas.webp" width="1080" height="959" alt="Manos del chef picando hierbas frescas con un cuchillo" loading="lazy" />
      </figure>
    </div>
    <ol class="steps">
      {pasos.map((p) => (
        <li class="step">
          <span class="step-n">{p.n}</span>
          <div>
            <h3 class="step-title">{p.titulo}</h3>
            <p class="step-text">{p.texto}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .fuego {
    position: relative; min-height: 100vh; min-height: 100svh; display: flex; align-items: center;
    background: radial-gradient(70% 60% at 85% 100%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%), var(--night);
    padding-block: 110px 90px;
  }
  .fuego-inner { width: 100%; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 64px; align-items: center; }
  .fuego-head { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .fuego-title { font-size: calc(clamp(2.4rem, 4.4vw, 4rem) * var(--display-scale)); }
  .fuego-title em { display: block; }
  .fuego-photo { margin: 0; border-radius: 2px; overflow: hidden; max-width: 420px; aspect-ratio: 4 / 3; }
  .fuego-photo img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.9) contrast(1.05); }

  .steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; min-width: 0; }
  .step {
    display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 20px; align-items: baseline;
    padding: 26px 0; border-top: 1px solid var(--line);
  }
  .step:last-child { border-bottom: 1px solid var(--line); }
  .step-n { font-family: var(--font-display); font-size: 2.4rem; line-height: 1; color: var(--accent); }
  .step-title { margin: 0 0 4px; font-family: var(--font-display); font-weight: var(--display-weight); font-size: calc(1.9rem * var(--display-scale)); line-height: 1.1; }
  .step-text { margin: 0; color: var(--muted); }

  /* Cada paso se enciende al entrar; sin soporte quedan encendidos */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .step {
        animation: step-light linear both; animation-timeline: view(); animation-range: entry 40% cover 42%;
      }
    }
  }
  @keyframes step-light {
    from { opacity: .18; transform: translateX(-18px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 820px) {
    .fuego-inner { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .fuego-photo { max-width: none; }
    .step { grid-template-columns: 52px minmax(0, 1fr); padding: 20px 0; }
    .step-n { font-size: 1.9rem; }
  }
</style>

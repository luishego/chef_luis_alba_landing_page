---
// Llamarada entre actos (PROVISIONAL): pinceladas de fuego en Canvas 2D.
// Adaptado del snippet de referencia: misma idea de pinceladas que suben con vaivén,
// pero con emisión controlada por el scroll, colores de la marca, sprites pre-renderizados,
// tiempo real (no por fotograma), resolución fija y pausa cuando no hay llamarada.
// La versión WebGL anterior queda en FlareGL.astro.
// Las marcas <div class="flare-mark" data-flare="0..1"> indican dónde ocurre cada llamarada y con qué fuerza.
---
<div class="flare-glow" aria-hidden="true"></div>
<canvas class="flare-canvas" aria-hidden="true"></canvas>

<script is:inline>
  (function () {
    var reduce = matchMedia('(prefers-reduced-motion: reduce)');
    var small = matchMedia('(max-width: 820px)');
    var glow = document.querySelector('.flare-glow');
    var canvas = document.querySelector('.flare-canvas');
    var ctx = canvas.getContext('2d');
    var marks = [].slice.call(document.querySelectorAll('.flare-mark'));
    if (!marks.length || !ctx) return;

    // Del color más caliente (abajo, al nacer) al más frío (arriba, al morir)
    var TONES = {
      fuego:  [[255, 222, 140], [255, 170, 60], [245, 118, 30], [228, 78, 22], [190, 44, 18]]
    };

    // Una pincelada por color, dibujada una sola vez (antes: un gradiente por partícula por fotograma)
    var SPRITE = 96, sprites = {};
    function brush(rgb) {
      var c = document.createElement('canvas'); c.width = SPRITE; c.height = SPRITE;
      var g = c.getContext('2d'), s = SPRITE * 0.42;
      g.translate(SPRITE / 2, SPRITE / 2);
      var grad = g.createLinearGradient(0, -s, 0, s);
      grad.addColorStop(0, 'rgba(' + rgb + ',0)');
      grad.addColorStop(0.5, 'rgba(' + rgb + ',1)');
      grad.addColorStop(1, 'rgba(' + rgb + ',0)');
      g.fillStyle = grad;
      g.beginPath();
      g.moveTo(-s / 3, -s);
      g.quadraticCurveTo(s / 2, 0, -s / 3, s);
      g.quadraticCurveTo(s / 2, 0, s / 3, -s / 2);
      g.closePath(); g.fill();
      g.fillStyle = 'rgba(' + rgb + ',0.7)';
      g.beginPath(); g.ellipse(s / 6, 0, s / 4, s / 2, 0, 0, Math.PI * 2); g.fill();
      return c;
    }
    function buildSprites(name) {
      if (sprites[name]) return;
      sprites[name] = TONES[name].map(brush);
    }

    // Pool fijo: nunca crece (el snippet original acumulaba partículas sin límite)
    var MAX = 0, pool = [], alive = 0;
    function makePool() {
      MAX = small.matches ? 180 : 420;
      pool = []; for (var i = 0; i < MAX; i++) pool.push({ on: false });
      alive = 0;
    }

    var W = 1, H = 1, scale = 1;
    function size() {
      var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      W = innerWidth; H = innerHeight; scale = Math.max(0.6, Math.min(1.4, W / 1440));
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      makePool();
    }
    size(); addEventListener('resize', size);

    function intensity() {
      var vh = innerHeight, best = 0;
      for (var i = 0; i < marks.length; i++) {
        var top = marks[i].getBoundingClientRect().top / vh;
        var s = Math.max(0, 1 - Math.abs(top - 0.5) / 0.42);
        s = s * s * (3 - 2 * s) * (parseFloat(marks[i].dataset.flare) || 1);
        if (s > best) best = s;
      }
      return best;
    }

    function rand(a, b) { return a + Math.random() * (b - a); }
    function spawn(I) {
      for (var i = 0; i < MAX; i++) {
        var p = pool[i];
        if (p.on) continue;
        var boost = 0.6 + I * 0.9;
        p.on = true; alive++;
        p.x = rand(-0.05, 1.05) * W;
        p.y = H + rand(0, 60);
        p.size = rand(14, 44) * scale * (0.7 + I * 0.8);
        p.vx = rand(-40, 40);
        p.vy = -rand(180, 420) * boost * (small.matches ? 0.85 : 1);
        p.rot = rand(-0.35, 0.35);
        p.vr = rand(-0.5, 0.5);
        p.sway = rand(18, 46);
        p.swaySpeed = rand(1.8, 3.6);
        p.phase = rand(0, Math.PI * 2);
        p.age = 0;
        p.life = rand(0.9, 2.1) * (0.8 + I * 0.4);
        p.alpha = rand(0.55, 1);
        p.heat = Math.random() < 0.55 ? 0 : 1; // arranca en dorado o en naranja
        return;
      }
    }

    var t = 0, last = 0, running = false, cur = 0, carry = 0;
    function step(dt, I) {
      // emisión proporcional a la intensidad, en partículas por segundo
      carry += I * (small.matches ? 320 : 760) * dt;
      while (carry >= 1) { spawn(I); carry -= 1; }

      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = onLight() ? 'source-over' : 'lighter';
      var set = sprites.fuego;
      for (var i = 0; i < MAX; i++) {
        var p = pool[i];
        if (!p.on) continue;
        p.age += dt;
        var k = p.age / p.life;
        if (k >= 1 || p.y < -120) { p.on = false; alive--; continue; }
        p.x += (p.vx + Math.cos(t * p.swaySpeed + p.phase) * p.sway) * dt;
        p.y += p.vy * dt;
        p.rot += p.vr * dt;
        // el color se enfría con la edad: 0 → 4
        var ci = Math.min(4, Math.floor(p.heat + k * 4));
        var fadeIn = Math.min(1, k / 0.12);
        var a = p.alpha * fadeIn * (1 - k);
        var s = p.size * (1.15 - k * 0.7) * 2.2;
        var tilt = p.rot + Math.cos(t * p.swaySpeed + p.phase) * 0.25;
        ctx.globalAlpha = a;
        ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(tilt);
        ctx.drawImage(set[ci], -s * 0.4, -s * 1.1, s * 0.8, s * 2.2);
        ctx.restore();
      }
      ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over';
    }

    var lightCheck = 0, lightNow = false;
    function onLight() {
      if (++lightCheck % 8 === 1) {
        var el = document.elementFromPoint(W / 2, H * 0.75);
        lightNow = !!(el && el.closest && el.closest('.band'));
      }
      return lightNow;
    }

    function frame(now) {
      var dt = Math.min(0.05, (now - last) / 1000 || 0.016); last = now; t += dt;
      var target = intensity();
      cur += (target - cur) * (1 - Math.exp(-dt * 10));
      glow.style.opacity = (cur * 0.55).toFixed(3);
      canvas.style.opacity = (cur > 0.01 || alive > 0) ? '1' : '0';
      step(dt, cur);
      if (cur > 0.004 || target > 0.004 || alive > 0) requestAnimationFrame(frame);
      else { running = false; ctx.clearRect(0, 0, W, H); }
    }
    function kick() {
      if (reduce.matches || running || document.hidden) return;
      running = true; last = performance.now(); requestAnimationFrame(frame);
    }
    buildSprites('fuego');
    addEventListener('scroll', kick, { passive: true });
    document.addEventListener('visibilitychange', kick);
    kick();
  })();
</script>

<style is:global>
  .flare-mark { position: relative; height: 0; pointer-events: none; }
  .flare-canvas {
    position: fixed; inset: 0; width: 100%; height: 100%; z-index: 25; pointer-events: none;
    opacity: 0; transition: opacity .2s linear;
  }
  .flare-glow {
    position: fixed; inset: 0; z-index: 24; pointer-events: none; opacity: 0;
    background: radial-gradient(120% 70% at 50% 110%, var(--spill), transparent 70%);
    mix-blend-mode: screen;
  }
  @media (prefers-reduced-motion: reduce) { .flare-canvas, .flare-glow { display: none; } }
</style>
